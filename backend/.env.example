# Vortu / Nexum backend configuration.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# ── Required (app will not start without these) ──────────────────────────────
# Strong random key for signing JWTs. Generate with: openssl rand -hex 32
SECRET_KEY=
# SQLAlchemy connection string. SQLite for local dev; use Postgres in prod.
DATABASE_URL=sqlite:///./nexum.db
# Neo4j graph DB password.
NEO4J_PASSWORD=

# ── Optional / has sane defaults ─────────────────────────────────────────────
# Set DEBUG=true ONLY in local development (exposes stack traces).
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Neo4j connection (defaults shown).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# Service URLs.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── Third-party API keys (leave blank to disable the integration) ────────────
ANTHROPIC_API_KEY=
APIFY_API_TOKEN=
# DeepSeek (cheap, text-only) — extraction routes TEXT steps here when set. OpenAI-compatible.
DEEPSEEK_API_KEY=

# Stripe.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_EXTRA_USER=
STRIPE_PRICE_VERA_PLUS=
STRIPE_LICENSE_STARTER=
STRIPE_LICENSE_PRO=
STRIPE_LICENSE_BUSINESS=
