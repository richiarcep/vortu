# Vela backend — environment template. Copy to `.env` on the server and fill in.
#   cp .env.example .env   (then edit; the real .env is gitignored)
# NEVER commit real secrets — this file ships only empty placeholders.

# ── Core (required) ───────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SECRET_KEY=
# 'production' makes auth cookies Secure + SameSite=Strict.
ENVIRONMENT=production
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Postgres (internal compose service; NOT exposed to the host) ───────────────
# The app + the role-init read these. Keep POSTGRES_PASSWORD and the password in
# DATABASE_URL identical.
POSTGRES_USER=vela
POSTGRES_PASSWORD=
POSTGRES_DB=vela
# App runtime connection.
#  - BEFORE activating RLS: connect as the owner `vela` so startup schema creation
#    works (MANAGE_SCHEMA=true).
#  - AFTER activating RLS: switch the user to vela_app and set MANAGE_SCHEMA=false
#    (vela_app is non-owner and cannot run the startup DDL). See docs/RLS.md.
DATABASE_URL=postgresql+psycopg://vela:CHANGE_ME@postgres:5432/vela

# Run create_all + ensure_runtime_schema at startup. TRUE while the app connects as
# the owner; set FALSE once DATABASE_URL points at vela_app (schema is then built /
# migrated out-of-band as the owner — see ADMIN_DATABASE_URL below).
MANAGE_SCHEMA=true

# ── RLS roles (created on first DB init; used when you ACTIVATE RLS) ───────────
VELA_APP_PASSWORD=
VELA_NETWORK_RO_PASSWORD=
VELA_WORKER_PASSWORD=
RLS_ENABLED=true
APP_DB_ROLE=
# Owner/superuser DSN used ONLY for DDL + `alembic upgrade` (creates tables, applies
# RLS policies). MUST be empty in the web tier — it bypasses RLS. Set it only where
# migrations run (a one-off / deploy step). Falls back to DATABASE_URL when empty.
#   postgresql+psycopg://vela:CHANGE_ME@postgres:5432/vela
ADMIN_DATABASE_URL=
# Read-only BYPASSRLS DSN for the cross-tenant agent (REQUIRED once RLS is active):
#   postgresql+psycopg://vela_network_ro:CHANGE_ME@postgres:5432/vela
NETWORK_DB_URL=
# Write-capable BYPASSRLS DSN for background jobs + backoffice (REQUIRED once RLS
# is active): postgresql+psycopg://vela_worker:CHANGE_ME@postgres:5432/vela
WORKER_DB_URL=

# ── Redis (internal compose service) ──────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
TRUSTED_PROXY=true

# ── URLs / CORS ───────────────────────────────────────────────────────────────
# Frontend lives on Vercel — its URL is the CORS origin + Stripe redirect target.
FRONTEND_URL=https://your-app.vercel.app
BACKEND_URL=https://167-233-199-102.sslip.io

# ── AI / LLM (blank disables the integration) ─────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
APIFY_API_TOKEN=

# ── Vera connector (external AI routing service; document extraction only) ─────
# When VERA_EXTRACTION_MODE=vera, document extraction calls the Vera API first and
# falls back to Vela's own pipeline if it fails. Leave mode=internal to keep the
# current behaviour. X-Vera-Key auth.
VERA_API_URL=
VERA_API_KEY=
VERA_EXTRACTION_MODE=internal
VERA_TRAIN_ENABLED=false

# ── Neo4j (optional — leave NEO4J_PASSWORD empty to disable the graph) ─────────
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Stripe (test keys for staging) ────────────────────────────────────────────
# Leave the webhook secret blank until you run `stripe listen` / create the webhook.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Connect (connected accounts) — secreto DISTINTO al de arriba; ruta /api/connect/webhook
STRIPE_CONNECT_WEBHOOK_SECRET=
# Plan prices are OPTIONAL — Vela builds inline prices from PLAN config by default.
# Set true only to use the price ids below.
STRIPE_USE_CONFIGURED_PRICES=false
STRIPE_PRICE_ID=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_EXTRA_USER=
STRIPE_PRICE_VERA_PLUS=
STRIPE_LICENSE_STARTER=
STRIPE_LICENSE_PRO=
STRIPE_LICENSE_BUSINESS=
# Optional platform fee on company sales (basis points; 0 = company keeps 100%).
CONNECT_APPLICATION_FEE_BPS=0

# ── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Veri*Factu (optional; empty → SANDBOX, no real AEAT submission) ────────────
AEAT_VERIFACTU_ENDPOINT=

# ── Misc ──────────────────────────────────────────────────────────────────────
# macOS-only cert workaround used in dev; leave empty on the server.
SSL_CERT_FILE=
