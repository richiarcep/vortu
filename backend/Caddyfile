# Vela backend staging reverse proxy.
# Caddy auto-provisions + renews a real Let's Encrypt cert for each hostname via
# HTTP-01 (needs ports 80 + 443 open, which ufw allows). The sslip.io hostname is
# kept alongside the real domain during the cut-over so nothing breaks.
#
# NOTE: www.getvela.dev must resolve to this server's IP (Cloudflare A record, set
# to "DNS only" / grey cloud so Caddy's HTTP-01 challenge isn't intercepted) BEFORE
# Caddy can issue its certificate.

www.getvela.dev, 167-233-199-102.sslip.io {
	encode gzip zstd

	# Backend (FastAPI): the API + health check. Everything else is the Next.js
	# frontend — same origin, so the HttpOnly refresh cookie is sent on /api calls.
	@api path /api/* /health
	handle @api {
		reverse_proxy app:8000 {
			# Make this proxy authoritative over X-Forwarded-For: overwrite any
			# client-supplied value with the real peer IP, so the app's login rate
			# limiter can't be evaded by spoofing X-Forwarded-For.
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}
	handle {
		reverse_proxy frontend:3000
	}
}
