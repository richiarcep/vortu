*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/chroma/
backend/uploads/
backend/payslips/
backend/reports/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
.vercel
*.tsbuildinfo
next-env.d.ts

# ── TLS certs ────────────────────────────────────────────────────────────────
