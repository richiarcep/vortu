# Vela production environment — copy to `.env` (gitignored) and fill in.
#   cp .env.production.example .env
# Compose reads this for both build-arg substitution and the backend container.

# ── Domain / URLs ────────────────────────────────────────────────────────────
# Your domain (DNS A record must point at this server). Use "localhost" to test.
DOMAIN=your-domain.com
# Public base URL of the site. Used as the frontend's build-time NEXT_PUBLIC_API_URL
# (same origin → API at /api/*) AND as the backend FRONTEND_URL (CORS + Stripe redirects).
PUBLIC_BASE_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# ── Required secrets (backend will not start without these) ──────────────────
# Generate: openssl rand -hex 32
SECRET_KEY=
# Neon Postgres. NOTE the `+psycopg` driver suffix and `sslmode=require`.
# From Neon's "connection string", change `postgresql://` → `postgresql+psycopg://`.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Neo4j Aura (optional — leave NEO4J_PASSWORD empty to disable graph) ───────
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
APIFY_API_TOKEN=
DEEPSEEK_API_KEY=

# ── Stripe (billing — leave blank to disable checkout) ───────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_EXTRA_USER=
STRIPE_PRICE_VERA_PLUS=

# ── Observability / hardening (optional; safe defaults if omitted) ───────────
# MUST be 'production' so auth cookies are issued Secure + SameSite=Strict.
ENVIRONMENT=production
# Shared rate-limit store (correct across workers). Empty → per-process in-memory.
REDIS_URL=
# Error tracking. Empty → disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Misc ─────────────────────────────────────────────────────────────────────
DEBUG=false
# Access-token TTL. Refresh tokens (HttpOnly cookie, rotating) live 30 days.
# Lower this to ~15–30 once the frontend does silent /api/auth/refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
