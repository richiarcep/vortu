# Frontend environment variables (Next.js 16)
#
# IMPORTANT: NEXT_PUBLIC_* vars are inlined into the client bundle at BUILD time
# (`next build`), NOT read at runtime. You must set this in the build environment
# (CI / Docker build args / host build settings) BEFORE building for production,
# or the app will fall back to http://localhost:8000 and every API call will fail.

# Base URL of the Vela backend API (FastAPI). No trailing slash.
# Local dev:  http://localhost:8000
# Production: https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8000
